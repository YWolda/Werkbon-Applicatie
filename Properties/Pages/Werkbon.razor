@page "/werkbon"
@inject TimeTrackingService Tracker
@inject WerkbonService Werkbonnen
@inject EmployeeService Employees
@inject IJSRuntime JS

<h1>Werkbon</h1>

@if (!_initialized)
{
    <p>Bezig met laden...</p>
}
else if (!Tracker.Projects.Any())
{
    <p>Je hebt nog geen opdrachten. Voeg er eerst een toe op de pagina <a href="opdrachten">Opdrachten</a>.</p>
}
else
{
    <div class="card mb-3">
        <label>Opdracht</label>
        <select class="form-select mb-2" @bind="_selectedProjectId" @bind:after="OnProjectOrWeekChanged">
            <option value="">-- Kies een opdracht --</option>
            @foreach (var project in Tracker.Projects)
            {
                <option value="@project.Id">@project.Name (@project.ClientName)</option>
            }
        </select>

        <label>Een datum in de gewenste week</label>
        <input type="date" class="form-control" @bind="_referenceDate" @bind:after="OnProjectOrWeekChanged" />
    </div>

    @if (_selectedProject is not null)
    {
        var weekNumber = TimeTrackingService.GetIsoWeekNumber(_weekMonday);

        <!-- ===== Dit gedeelte wordt geexporteerd als PDF ===== -->
        <div id="werkbonDocument" class="doc">
            <div class="doc-header-row">
                <img src="img/boikon-logo.jpg" class="doc-logo" alt="BOIKON" />
                <div class="doc-title">SERVICE<br />REPORT</div>
            </div>

            <div class="doc-section-title">INFORMATION</div>
            <table class="doc-info-table">
                <tbody>
                    <tr>
                        <td class="doc-label">Project number BOIKON</td>
                        <td class="doc-value">@_selectedProject.ProjectNumber</td>
                        <td class="doc-label">Customer name</td>
                        <td class="doc-value">@_selectedProject.ClientName</td>
                    </tr>
                    <tr>
                        <td class="doc-label">Date / week</td>
                        <td class="doc-value">Week @weekNumber (@_weekMonday.ToString("dd-MM-yyyy") t/m @_weekMonday.AddDays(6).ToString("dd-MM-yyyy"))</td>
                        <td class="doc-label">Reference client</td>
                        <td class="doc-value">@_selectedProject.ReferenceClient</td>
                    </tr>
                    <tr>
                        <td class="doc-label">Location</td>
                        <td class="doc-value">@_selectedProject.Location</td>
                        <td class="doc-label">Contact person</td>
                        <td class="doc-value">@_selectedProject.ContactPerson</td>
                    </tr>
                    <tr>
                        <td class="doc-label">Project description</td>
                        <td class="doc-value" colspan="3">@_selectedProject.Description</td>
                    </tr>
                </tbody>
            </table>

            <div class="doc-section-title">WORK DESCRIPTION</div>
            <textarea class="doc-textarea" rows="4" placeholder="Wat is er deze week uitgevoerd?" @bind="_workDescription"></textarea>

            <div class="doc-section-title">MATERIALS</div>
            <table class="doc-materials-table">
                <thead>
                    <tr><th style="width: 80px">Qty.</th><th>Description</th><th class="no-print" style="width: 40px"></th></tr>
                </thead>
                <tbody>
                    @foreach (var material in _materials)
                    {
                        <tr>
                            <td><input class="doc-input" @bind="material.Quantity" /></td>
                            <td><input class="doc-input" @bind="material.Description" /></td>
                            <td class="no-print"><button class="btn btn-sm btn-outline-danger" @onclick="() => _materials.Remove(material)">✕</button></td>
                        </tr>
                    }
                </tbody>
            </table>
            <button class="btn btn-sm btn-outline-secondary no-print mt-1 mb-2" @onclick="AddMaterialPair">
                + Materiaalregel toevoegen
            </button>

            <div class="doc-section-title">HOURS</div>
            <div class="doc-employee-line">
                <span>Name employee (BOIKON): <strong>@_employeeName</strong></span>
            </div>
            <div class="doc-employee-line no-print">
                <select class="doc-input" style="max-width:250px" value="@_employeeSelection" @onchange="OnEmployeeSelectionChanged">
                    <option value="">-- Kies medewerker --</option>
                    @foreach (var employee in Employees.Employees)
                    {
                        <option value="@employee.Name">@employee.Name</option>
                    }
                    <option value="__custom__">-- Mijn naam staat er niet bij --</option>
                </select>
                @if (_useCustomName)
                {
                    <input class="doc-input mt-1" style="max-width:250px" placeholder="Typ je naam" @bind="_employeeName" />
                }
            </div>

            <div class="table-scroll">
                <table class="doc-hours-table">
                    <thead>
                        <tr>
                            <th></th>
                            @foreach (var day in _editableDays)
                            {
                                <th>@DayLabel(day.Date)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Travel hrs: to</td>
                            @foreach (var day in _editableDays)
                            {
                                <td><input type="number" min="0" step="0.25" class="doc-input hour-input" @bind="day.TravelToHours" /></td>
                            }
                        </tr>
                        <tr>
                            <td>Work hours</td>
                            @foreach (var day in _editableDays)
                            {
                                <td><input type="number" min="0" step="0.25" class="doc-input hour-input" @bind="day.WorkHours" /></td>
                            }
                        </tr>
                        <tr>
                            <td>Prep./rework</td>
                            @foreach (var day in _editableDays)
                            {
                                <td><input type="number" min="0" step="0.25" class="doc-input hour-input" @bind="day.PrepReworkHours" /></td>
                            }
                        </tr>
                        <tr class="overtime-row">
                            <td>Overtime</td>
                            @foreach (var day in _editableDays)
                            {
                                <td><input type="number" min="0" step="0.25" class="doc-input hour-input" @bind="day.OvertimeHours" /></td>
                            }
                        </tr>
                        <tr>
                            <td>Travel hrs: back</td>
                            @foreach (var day in _editableDays)
                            {
                                <td><input type="number" min="0" step="0.25" class="doc-input hour-input" @bind="day.TravelBackHours" /></td>
                            }
                        </tr>
                        <tr>
                            <td>Kilometers</td>
                            @foreach (var day in _editableDays)
                            {
                                <td><input type="number" min="0" step="1" class="doc-input hour-input" @bind="day.Kilometers" /></td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
            <p class="text-muted small mt-1 no-print">
                De reistijd/werkuren/overuren staan automatisch voorgevuld op basis van je
                tijdregistratie. Klopt er iets niet? Pas het gerust hier direct aan.
            </p>

            <div class="doc-section-title">APPROVAL</div>
            <div class="doc-approval-row">
                <div class="doc-approval-box">
                    <div class="doc-caption-top">Name employee BOIKON:</div>
                    <div class="doc-input mb-1"><strong>@_employeeName</strong></div>
                    <canvas id="employeeCanvas" class="signature-canvas" width="350" height="110"></canvas>
                    <button class="btn btn-sm btn-outline-secondary no-print mt-1" @onclick='() => ClearSignature("employeeCanvas")'>Wis</button>
                    <div class="doc-caption">Signature</div>
                </div>
                <div class="doc-approval-box">
                    <div class="doc-caption-top">Name client:</div>
                    <input class="doc-input mb-1" placeholder="Naam klant" @bind="_clientSignerName" />
                    <canvas id="clientCanvas" class="signature-canvas" width="350" height="110"></canvas>
                    <button class="btn btn-sm btn-outline-secondary no-print mt-1" @onclick='() => ClearSignature("clientCanvas")'>Wis</button>
                    <div class="doc-caption">Signature</div>
                </div>
                <div class="doc-approval-box">
                    <div class="doc-caption-top">Name project leader client (opt.)</div>
                    <input class="doc-input mb-1" placeholder="Naam (optioneel)" @bind="_projectLeaderName" />
                    <canvas id="leaderCanvas" class="signature-canvas" width="350" height="110"></canvas>
                    <button class="btn btn-sm btn-outline-secondary no-print mt-1" @onclick='() => ClearSignature("leaderCanvas")'>Wis</button>
                    <div class="doc-caption">Signature (optioneel)</div>
                </div>
            </div>
        </div>
        <!-- ===== Einde PDF-gedeelte ===== -->

        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <div class="alert alert-success mt-3">@_statusMessage</div>
        }

        <div class="doc-actions">
            <button class="btn btn-outline-primary w-100 mb-2" @onclick="DownloadPdf">📥 Downloaden / opslaan op dit toestel</button>
            <button class="btn btn-success w-100 mb-2" @onclick="SaveWerkbon">Werkbon opslaan</button>

            @if (_savedRecord is not null)
            {
                <div class="share-hint">
                    Opgeslagen! Download de PDF hierboven en voeg 'm zelf toe als bijlage
                    in onderstaande Mail/WhatsApp-berichten.
                </div>
                <a href="@MailtoLink" class="btn btn-outline-secondary w-100 mb-2">📧 Open in Mail</a>
                <a href="@WhatsAppLink" target="_blank" class="btn btn-outline-secondary w-100 mb-4">💬 Open in WhatsApp</a>
            }
        </div>
    }
}

@code {
    private bool _initialized = false;
    private string _selectedProjectId = string.Empty;
    private Project? _selectedProject;
    private DateTime _referenceDate = DateTime.Today;
    private DateOnly _weekMonday;
    private List<WerkbonDayHours> _editableDays = new();

    private string _workDescription = string.Empty;
    private List<MaterialLine> _materials = new();
    private string _employeeName = string.Empty;
    private string _employeeSelection = string.Empty;
    private bool _useCustomName = false;
    private string _clientSignerName = string.Empty;
    private string _projectLeaderName = string.Empty;
    private string? _statusMessage;
    private bool _signaturePadsReady = false;
    private WerkbonRecord? _savedRecord;

    protected override async Task OnInitializedAsync()
    {
        await Tracker.InitializeAsync();
        await Tracker.RefreshProjectsAsync();
        await Werkbonnen.InitializeAsync();
        await Employees.InitializeAsync();
        _employeeName = Werkbonnen.GetLastUsedEmployeeName() ?? string.Empty;
        _useCustomName = !string.IsNullOrEmpty(_employeeName) && !Employees.Employees.Any(e => e.Name == _employeeName);
        _employeeSelection = _useCustomName ? "__custom__" : _employeeName;
        _initialized = true;
        RecalculateWeek();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_selectedProject is not null && !_signaturePadsReady)
        {
            await JS.InvokeVoidAsync("signaturePad.init", "employeeCanvas");
            await JS.InvokeVoidAsync("signaturePad.init", "clientCanvas");
            await JS.InvokeVoidAsync("signaturePad.init", "leaderCanvas");
            _signaturePadsReady = true;
        }
    }

    private void OnProjectOrWeekChanged()
    {
        RecalculateWeek();
        _statusMessage = null;
        _savedRecord = null;
        _signaturePadsReady = false;
    }

    private void RecalculateWeek()
    {
        _selectedProject = Guid.TryParse(_selectedProjectId, out var id) ? Tracker.GetProject(id) : null;

        var date = DateOnly.FromDateTime(_referenceDate);
        var dayOfWeek = (int)date.DayOfWeek == 0 ? 7 : (int)date.DayOfWeek;
        _weekMonday = date.AddDays(-(dayOfWeek - 1));

        var weekSummary = _selectedProject is not null
            ? Tracker.GetWeekSummary(_weekMonday, _selectedProject.Id)
            : new List<DayHoursSummary>();

        // Document toont zondag t/m zaterdag, zoals het origineel.
        var sundayFirst = weekSummary.Count == 7
            ? new List<DayHoursSummary> { weekSummary[6] }.Concat(weekSummary.Take(6)).ToList()
            : new List<DayHoursSummary>();

        // Voorvullen vanuit de automatische berekening, maar wel los aanpasbaar houden.
        _editableDays = sundayFirst.Select(d => new WerkbonDayHours
        {
            Date = d.Date,
            TravelToHours = Math.Round(d.TravelTo.TotalHours, 2),
            WorkHours = Math.Round(d.Work.TotalHours, 2),
            PrepReworkHours = 0,
            OvertimeHours = Math.Round(d.Overtime.TotalHours, 2),
            TravelBackHours = Math.Round(d.TravelBack.TotalHours, 2),
            Kilometers = 0
        }).ToList();
    }

    private void AddMaterialPair()
    {
        _materials.Add(new MaterialLine());
    }

    private void OnEmployeeSelectionChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        _employeeSelection = value;

        if (value == "__custom__")
        {
            _useCustomName = true;
            _employeeName = string.Empty;
        }
        else
        {
            _useCustomName = false;
            _employeeName = value;
        }
    }

    private async Task ClearSignature(string canvasId)
    {
        await JS.InvokeVoidAsync("signaturePad.clear", canvasId);
    }

    private async Task DownloadPdf()
    {
        var filename = $"Werkrapport_{_selectedProject!.Name}_week{TimeTrackingService.GetIsoWeekNumber(_weekMonday)}.pdf";
        await JS.InvokeVoidAsync("pdfExport.exportElement", "werkbonDocument", filename);
    }

    private async Task SaveWerkbon()
    {
        if (_selectedProject is null) return;

        var employeeEmpty = await JS.InvokeAsync<bool>("signaturePad.isEmpty", "employeeCanvas");
        var clientEmpty = await JS.InvokeAsync<bool>("signaturePad.isEmpty", "clientCanvas");

        if (string.IsNullOrWhiteSpace(_employeeName) || employeeEmpty)
        {
            await JS.InvokeVoidAsync("alert", "Vul je naam in en zet je handtekening voordat je opslaat.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_clientSignerName) || clientEmpty)
        {
            await JS.InvokeVoidAsync("alert", "Vul de naam van de klant in en laat de klant ondertekenen voordat je opslaat.");
            return;
        }

        var record = new WerkbonRecord
        {
            ProjectId = _selectedProject.Id,
            WeekNumber = TimeTrackingService.GetIsoWeekNumber(_weekMonday),
            Year = _weekMonday.Year,
            WeekStart = _weekMonday,
            WeekEnd = _weekMonday.AddDays(6),
            EmployeeName = _employeeName.Trim(),
            WorkDescription = _workDescription.Trim(),
            Materials = _materials.Where(m => !string.IsNullOrWhiteSpace(m.Description)).ToList(),
            DayHours = _editableDays,
            ClientSignerName = _clientSignerName.Trim(),
            EmployeeSignatureDataUrl = await JS.InvokeAsync<string>("signaturePad.getDataUrl", "employeeCanvas"),
            ClientSignatureDataUrl = await JS.InvokeAsync<string>("signaturePad.getDataUrl", "clientCanvas")
        };

        await Werkbonnen.SaveAsync(record);
        _savedRecord = record;
        _statusMessage = "Werkbon opgeslagen! Je vindt 'm terug op de pagina Overzicht.";
    }

    private string MailtoLink
    {
        get
        {
            if (_savedRecord is null) return "#";
            var subject = Uri.EscapeDataString($"Werkbon week {_savedRecord.WeekNumber} - {_selectedProject?.Name}");
            var body = Uri.EscapeDataString(
                $"Beste {_savedRecord.ClientSignerName},\n\n" +
                $"Hierbij de werkbon voor week {_savedRecord.WeekNumber} " +
                $"({_savedRecord.WeekStart:dd-MM-yyyy} t/m {_savedRecord.WeekEnd:dd-MM-yyyy}) " +
                $"voor opdracht \"{_selectedProject?.Name}\".\n\n" +
                $"(De PDF vind je als bijlage - vergeet niet deze zelf toe te voegen.)\n\n" +
                $"Met vriendelijke groet,\n{_savedRecord.EmployeeName}");
            return $"mailto:?subject={subject}&body={body}";
        }
    }

    private string WhatsAppLink
    {
        get
        {
            if (_savedRecord is null) return "#";
            var text = Uri.EscapeDataString(
                $"Werkbon week {_savedRecord.WeekNumber} ({_selectedProject?.Name}) - zie de bijgevoegde PDF.");
            return $"https://wa.me/?text={text}";
        }
    }

    private static string DayLabel(DateOnly date) => date.ToString("ddd d", new System.Globalization.CultureInfo("en-GB"));
}
