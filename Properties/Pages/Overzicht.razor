@page "/overzicht"
@inject TimeTrackingService Tracker
@inject WerkbonService Werkbonnen
@inject AuthService Auth
@inject IJSRuntime JS

<h1>Overzicht</h1>

<h3>Werkbonnen</h3>

@if (!Werkbonnen.Records.Any())
{
    <p>Nog geen werkbonnen opgeslagen. Maak er een aan op de pagina <a href="werkbon">Werkbon</a>.</p>
}
else
{
    @foreach (var record in Werkbonnen.Records)
    {
        var project = Tracker.GetProject(record.ProjectId);

        <div class="card mb-2">
            <div class="d-flex justify-content-between">
                <strong>Week @record.WeekNumber, @record.Year</strong>
                <span class="@(record.IsSigned ? "text-success" : "text-warning")">
                    @(record.IsSigned ? "✔ Ondertekend" : "⚠ Niet volledig ondertekend")
                </span>
            </div>
            <div class="text-muted small mb-1">
                @record.WeekStart.ToString("dd-MM-yyyy") t/m @record.WeekEnd.ToString("dd-MM-yyyy")
            </div>
            <table class="table table-sm mb-0">
                <tbody>
                    <tr><td>Opdracht</td><td>@(project?.Name ?? "(verwijderde opdracht)")</td></tr>
                    <tr><td>Klant</td><td>@(project?.ClientName ?? "-")</td></tr>
                    <tr><td>Voor wie</td><td>@record.ClientSignerName</td></tr>
                    <tr><td>Gewerkt door</td><td>@record.EmployeeName</td></tr>
                    <tr><td>Totaal werkuren</td><td>@record.DayHours.Sum(d => d.WorkHours).ToString("0.##")u</td></tr>
                    <tr><td>Totaal overuren</td><td>@record.DayHours.Sum(d => d.OvertimeHours).ToString("0.##")u</td></tr>
                </tbody>
            </table>
            <div class="d-flex gap-2 mt-2">
                <a href="werkbon-bekijken/@record.Id" class="btn btn-sm btn-outline-primary">Bekijken / downloaden als PDF</a>
                @if (Auth.CurrentUser?.IsAdmin == true)
                {
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteWerkbon(record.Id)">
                        Verwijderen
                    </button>
                }
            </div>
        </div>
    }
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await Tracker.InitializeAsync();
        await Tracker.RefreshProjectsAsync();
        await Werkbonnen.InitializeAsync();
    }

    private async Task DeleteWerkbon(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            "Weet je zeker dat je deze werkbon definitief wil verwijderen? Dit kan niet ongedaan gemaakt worden.");

        if (confirmed)
        {
            await Werkbonnen.DeleteAsync(id);
        }
    }
}
