@page "/opdrachten"
@inject TimeTrackingService Tracker
@inject EmployeeService Employees
@inject AuthService Auth
@inject IJSRuntime JS

<h1>Opdrachten</h1>

<div class="card mb-4">
    <h3>Nieuwe opdracht toevoegen</h3>
    <input @bind="_name" placeholder="Naam opdracht" class="form-control mb-2" />
    <input @bind="_projectNumber" placeholder="Projectnummer" class="form-control mb-2" />
    <input @bind="_client" placeholder="Klantnaam" class="form-control mb-2" />
    <input @bind="_location" placeholder="Locatie" class="form-control mb-2" />
    <input @bind="_contactPerson" placeholder="Contactpersoon" class="form-control mb-2" />
    <input @bind="_referenceClient" placeholder="Referentie klant" class="form-control mb-2" />
    <textarea @bind="_description" placeholder="Projectomschrijving" class="form-control mb-2" rows="2"></textarea>

    <button class="btn btn-primary w-100" @onclick="AddProject" disabled="@string.IsNullOrWhiteSpace(_name)">
        Toevoegen
    </button>
</div>

<h3>Actieve opdrachten</h3>

@if (!Tracker.Projects.Any())
{
    <p>Nog geen opdrachten toegevoegd.</p>
}
else
{
    @foreach (var project in Tracker.Projects)
    {
        <div class="card mb-2">
            <strong>@project.Name</strong> — @project.ClientName
            <div class="text-muted small">
                Projectnr: @project.ProjectNumber ·
                Locatie: @project.Location ·
                Contact: @project.ContactPerson
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-secondary mt-2" @onclick="() => Archive(project.Id)">
                    Archiveren
                </button>
                @if (Auth.CurrentUser?.IsAdmin == true)
                {
                    <button class="btn btn-sm btn-outline-danger mt-2" @onclick="() => DeleteProject(project.Id)">
                        Verwijderen
                    </button>
                }
            </div>
        </div>
    }
}

@{
    var archivedProjects = Tracker.AllProjects.Where(p => p.IsArchived).ToList();
}

@if (archivedProjects.Any())
{
    <h3 class="mt-4">Gearchiveerde opdrachten</h3>
    <p class="text-muted small">Verborgen uit de keuzelijsten, maar niet verwijderd.</p>

    @foreach (var project in archivedProjects)
    {
        <div class="card mb-2">
            <strong>@project.Name</strong> — @project.ClientName
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-secondary mt-2" @onclick="() => Unarchive(project.Id)">
                    Herstellen
                </button>
                @if (Auth.CurrentUser?.IsAdmin == true)
                {
                    <button class="btn btn-sm btn-outline-danger mt-2" @onclick="() => DeleteProject(project.Id)">
                        Verwijderen
                    </button>
                }
            </div>
        </div>
    }
}

@if (Auth.CurrentUser?.IsAdmin == true)
{
    <h3 class="mt-4">Medewerkers beheren</h3>
    <p class="text-muted small">Alleen zichtbaar voor admins.</p>

    <div class="card mb-4">
        <div class="d-flex gap-2 mb-3">
            <input @bind="_newEmployeeName" placeholder="Naam nieuwe medewerker" class="form-control" />
            <button class="btn btn-primary" @onclick="AddEmployee" disabled="@string.IsNullOrWhiteSpace(_newEmployeeName)">
                Toevoegen
            </button>
        </div>

        @if (!Employees.Employees.Any())
        {
            <p class="text-muted mb-0">Nog geen medewerkers toegevoegd.</p>
        }
        else
        {
            @foreach (var employee in Employees.Employees)
            {
                <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                    <span>@employee.Name</span>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveEmployee(employee.Id)">
                        Verwijderen
                    </button>
                </div>
            }
        }
    </div>
}

@code {
    private string _name = string.Empty;
    private string _projectNumber = string.Empty;
    private string _client = string.Empty;
    private string _location = string.Empty;
    private string _contactPerson = string.Empty;
    private string _referenceClient = string.Empty;
    private string _description = string.Empty;
    private string _newEmployeeName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Tracker.InitializeAsync();
        await Tracker.RefreshProjectsAsync();
        await Employees.InitializeAsync();
    }

    private async Task AddProject()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;

        await Tracker.AddProjectAsync(new Project
        {
            Name = _name.Trim(),
            ProjectNumber = _projectNumber.Trim(),
            ClientName = _client.Trim(),
            Location = _location.Trim(),
            ContactPerson = _contactPerson.Trim(),
            ReferenceClient = _referenceClient.Trim(),
            Description = _description.Trim()
        });

        _name = _projectNumber = _client = _location = _contactPerson = _referenceClient = _description = string.Empty;
    }

    private async Task Archive(Guid id)
    {
        await Tracker.ArchiveProjectAsync(id);
    }

    private async Task Unarchive(Guid id)
    {
        await Tracker.UnarchiveProjectAsync(id);
    }

    private async Task DeleteProject(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            "Weet je zeker dat je deze opdracht definitief wil verwijderen? Dit kan niet ongedaan gemaakt worden.");

        if (confirmed)
        {
            await Tracker.DeleteProjectAsync(id);
        }
    }

    private async Task AddEmployee()
    {
        if (string.IsNullOrWhiteSpace(_newEmployeeName)) return;
        await Employees.AddEmployeeAsync(_newEmployeeName);
        _newEmployeeName = string.Empty;
    }

    private async Task RemoveEmployee(Guid id)
    {
        await Employees.RemoveEmployeeAsync(id);
    }
}
