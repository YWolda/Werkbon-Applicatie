@inject PinLockService PinLock

<div class="login-wrapper">
    <div class="login-card">
        <h2>Stel een pincode in</h2>
        <p class="text-muted">@(_stage == 1 ? "Kies een pincode van 4 cijfers." : "Herhaal je pincode ter bevestiging.")</p>

        <div class="pin-dots mb-3">
            @for (int i = 0; i < 4; i++)
            {
                <span class="pin-dot @(i < _currentInput.Length ? "filled" : "")"></span>
            }
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }

        <NumericKeypad OnDigit="HandleDigit" OnBackspace="HandleBackspace" />
    </div>
</div>

@code {
    [Parameter] public EventCallback OnPinSet { get; set; }

    private int _stage = 1;
    private string _firstPin = string.Empty;
    private string _currentInput = string.Empty;
    private string? _error;

    private async Task HandleDigit(string digit)
    {
        if (_currentInput.Length >= 4) return;

        _error = null;
        _currentInput += digit;

        if (_currentInput.Length < 4) return;

        if (_stage == 1)
        {
            _firstPin = _currentInput;
            _currentInput = string.Empty;
            _stage = 2;
        }
        else
        {
            if (_currentInput == _firstPin)
            {
                await PinLock.SetPinAsync(_currentInput);
                await OnPinSet.InvokeAsync();
            }
            else
            {
                _error = "De pincodes komen niet overeen. Probeer opnieuw.";
                _stage = 1;
                _firstPin = string.Empty;
                _currentInput = string.Empty;
            }
        }
    }

    private void HandleBackspace()
    {
        if (_currentInput.Length > 0)
        {
            _currentInput = _currentInput[..^1];
            _error = null;
        }
    }
}
