<div class="keypad">
    @foreach (var digit in new[] { "1", "2", "3", "4", "5", "6", "7", "8", "9" })
    {
        <button type="button" class="keypad-btn" @onclick="() => OnDigit.InvokeAsync(digit)">@digit</button>
    }
    <div></div>
    <button type="button" class="keypad-btn" @onclick='() => OnDigit.InvokeAsync("0")'>0</button>
    <button type="button" class="keypad-btn keypad-btn-clear" @onclick="() => OnBackspace.InvokeAsync()">⌫</button>
</div>

@code {
    [Parameter] public EventCallback<string> OnDigit { get; set; }
    [Parameter] public EventCallback OnBackspace { get; set; }
}
