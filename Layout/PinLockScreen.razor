@inject PinLockService PinLock
@inject AuthService Auth

<div class="login-wrapper">
    <div class="login-card">
        <img src="img/boikon-logo.jpg" class="login-logo" alt="BOIKON" />
        <h2>Ontgrendelen</h2>
        <p class="text-muted">Voer je 4-cijferige pincode in.</p>

        <input type="tel" inputmode="numeric" maxlength="4" class="form-control mb-2 pin-input"
               placeholder="Pincode" @bind="_pin" @bind:event="oninput" @onkeyup="HandleKeyUp" />

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }

        <button class="btn btn-primary w-100 mb-2" @onclick="Unlock">Ontgrendelen</button>
        <button class="btn btn-link w-100" @onclick="Logout">Pincode vergeten? Log opnieuw in</button>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnUnlocked { get; set; }

    private string _pin = string.Empty;
    private string? _error;

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Unlock();
        }
    }

    private async Task Unlock()
    {
        var success = await PinLock.TryUnlockAsync(_pin);
        if (success)
        {
            await OnUnlocked.InvokeAsync();
        }
        else
        {
            _error = "Onjuiste pincode.";
            _pin = string.Empty;
        }
    }

    private async Task Logout()
    {
        await PinLock.ClearPinAsync();
        await Auth.LogoutAsync();
    }
}
